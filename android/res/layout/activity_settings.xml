<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAS音乐盒"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/sub"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/saved_title"
            style="@style/Section"
            android:text="已保存的服务器（点一下切换）" />

        <LinearLayout
            android:id="@+id/server_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/form_title"
            style="@style/Section"
            android:text="添加服务器" />

        <EditText
            android:id="@+id/input_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.1.10:8090"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/sub" />

        <EditText
            android:id="@+id/input_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="名称（可不填，如：家里 / 外网）"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="20"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/sub" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:minHeight="22dp"
            android:textColor="@color/sub"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="测试连接" />

            <Button
                android:id="@+id/btn_save"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="测试并保存" />

            <ProgressBar
                android:id="@+id/busy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:visibility="invisible" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_cancel_edit"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消修改"
            android:textColor="@color/sub"
            android:visibility="gone" />

        <TextView
            style="@style/Section"
            android:text="选项" />

        <Switch
            android:id="@+id/sw_keep_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="使用时保持屏幕常亮"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/sw_fab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="显示悬浮菜单按钮（刷新 / 切换 / 设置）"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_done"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="进入播放器" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/sub"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
